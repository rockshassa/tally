<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.devplaceholder.B13UVL67.tally</string>
	</array>

	<!-- SPEC §8 / §10: the user's *private* CloudKit database, never a shared or
	     public one. Container id is mirrored literally in
	     TallyKit's TallyStore.cloudKitContainerIdentifier. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.devplaceholder.B13UVL67.tally</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>

	<!-- Silent pushes are how NSPersistentCloudKitContainer learns another
	     device wrote something; without this the mirror only refreshes when the
	     app opens. -->
	<key>aps-environment</key>
	<string>development</string>

	<!-- SPEC §4 "Refresh": HKObserverQuery + background delivery re-runs the
	     correlation engine as new activity data arrives. Read-only — Tally never
	     writes HealthKit data to its own store or to CloudKit (SPEC §10), so this
	     grants wake-ups and nothing else. Without it the observer still works
	     while the app is foregrounded; the feature degrades in latency, not in
	     behaviour. -->
	<key>com.apple.developer.healthkit.background-delivery</key>
	<true/>
</dict>
</plist>
